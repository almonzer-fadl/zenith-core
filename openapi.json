{
  "openapi": "3.1.0",
  "info": {
    "title": "Zenith Core API",
    "version": "1.1.0"
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    }
  ],
  "components": {
    "schemas": {
      "ApiError": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "const": false
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "VALIDATION_ERROR",
                  "AUTH_ERROR",
                  "CONFLICT_ERROR",
                  "DUPLICATE_ERROR",
                  "RATE_LIMIT_ERROR",
                  "DOWNSTREAM_ERROR",
                  "SERVER_ERROR",
                  "NOT_FOUND",
                  "INVALID_CREDENTIALS",
                  "INVALID_ID",
                  "MISSING_VAPID",
                  "NOT_SUBSCRIBED"
                ]
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": [
                  "object",
                  "null"
                ]
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "ok",
          "error"
        ]
      },
      "SyncStatus": {
        "type": "object",
        "properties": {
          "lastSuccessAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "pendingCount": {
            "type": "integer"
          },
          "failedCount": {
            "type": "integer"
          }
        },
        "required": [
          "lastSuccessAt",
          "pendingCount",
          "failedCount"
        ]
      },
      "Profile": {
        "type": "object",
        "properties": {
          "dob": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "heightCm": {
            "type": "number"
          },
          "targetCarbs": {
            "type": "number"
          },
          "targetProtein": {
            "type": "number"
          },
          "targetFat": {
            "type": "number"
          },
          "targetCalories": {
            "type": "number"
          },
          "glucoseLow": {
            "type": "number"
          },
          "glucoseHigh": {
            "type": "number"
          }
        },
        "required": [
          "heightCm",
          "targetCarbs",
          "targetProtein",
          "targetFat",
          "targetCalories",
          "glucoseLow",
          "glucoseHigh"
        ]
      },
      "ReminderRule": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "domain": {
            "type": "string",
            "enum": [
              "insulin",
              "glucose",
              "meals",
              "sleep",
              "workout"
            ]
          },
          "enabled": {
            "type": "boolean"
          },
          "times": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "severity": {
            "type": "string",
            "enum": [
              "normal",
              "high"
            ]
          }
        },
        "required": [
          "id",
          "domain",
          "enabled",
          "times",
          "severity"
        ]
      },
      "ReminderEvent": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "ruleId": {
            "type": [
              "string",
              "null"
            ]
          },
          "domain": {
            "type": "string"
          },
          "action": {
            "type": "string",
            "enum": [
              "done",
              "missed",
              "snooze"
            ]
          },
          "scheduledAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "actedAt": {
            "type": "string",
            "format": "date-time"
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "domain",
          "action",
          "actedAt"
        ]
      },
      "ReportsMetrics": {
        "type": "object",
        "properties": {
          "tir": {
            "type": "number"
          },
          "glucoseAverage": {
            "type": "number"
          },
          "glucoseVariabilitySd": {
            "type": "number"
          },
          "glucoseVariabilityCv": {
            "type": "number"
          },
          "hypoCount": {
            "type": "integer"
          },
          "hyperCount": {
            "type": "integer"
          },
          "adherenceRate": {
            "type": "number"
          },
          "adherenceDone": {
            "type": "integer"
          },
          "adherenceMissed": {
            "type": "integer"
          },
          "adherenceSnoozed": {
            "type": "integer"
          },
          "sleepAverageHours": {
            "type": "number"
          },
          "sleepConsistency": {
            "type": "number"
          },
          "trainingLoadKm": {
            "type": "number"
          }
        },
        "required": [
          "tir",
          "glucoseAverage",
          "glucoseVariabilitySd",
          "glucoseVariabilityCv",
          "hypoCount",
          "hyperCount",
          "adherenceRate",
          "adherenceDone",
          "adherenceMissed",
          "adherenceSnoozed",
          "sleepAverageHours",
          "sleepConsistency",
          "trainingLoadKm"
        ]
      }
    }
  },
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "summary": "Login"
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "summary": "Logout"
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "summary": "Current user"
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "summary": "Refresh token"
      }
    },
    "/api/v1/sessions": {
      "get": {
        "summary": "List sessions"
      }
    },
    "/api/v1/sessions/{id}": {
      "delete": {
        "summary": "Revoke session"
