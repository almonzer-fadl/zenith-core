    "/api/v1/reports": {
      "get": {
        "summary": "Reports data",
        "parameters": [
          {
            "name": "windowDays",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 7,
              "maximum": 90
            },
            "required": false
          }
        ]
      }
    },
    "/api/v1/reminders/rules": {
      "get": {
        "summary": "List reminder rules"
      },
      "post": {
        "summary": "Upsert reminder rule"
      }
    },
    "/api/v1/reminders/rules/{id}": {
      "get": {
        "summary": "Get reminder rule"
      },
      "patch": {
        "summary": "Update reminder rule"
      },
      "delete": {
        "summary": "Delete reminder rule"
      }
    },
    "/api/v1/reminders/events": {
      "get": {
        "summary": "List reminder events"
      },
      "post": {
        "summary": "Create reminder event action"
      }
    },
    "/api/v1/reminders/adherence": {
      "get": {
        "summary": "Reminder adherence summary"
      }
    },
    "/api/v1/profile": {
      "get": {
        "summary": "Get profile settings"
      },
      "put": {
        "summary": "Update profile settings"
      }
    },
    "/api/v1/sync/status": {
      "get": {
        "summary": "Get sync status",
        "responses": {
          "200": {
            "description": "Sync status",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/SyncStatus"
                    }
                  },
                  "required": [
                    "ok",
                    "data"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/push": {
      "post": {
        "summary": "Save push subscription"
      },
      "delete": {
        "summary": "Delete push subscription"
      }
    },
    "/api/v1/notifications/trigger": {
      "post": {
        "summary": "Trigger push notification"
      }
    },
    "/api/v1/monitoring/summary": {
      "get": {
        "summary": "Monitoring summary"
      }
    }
  }
