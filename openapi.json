    },
    "/api/v1/health": {
      "get": {
        "summary": "List health logs"
      },
      "post": {
        "summary": "Create health log"
      }
    },
    "/api/v1/health/{id}": {
      "patch": {
        "summary": "Update health log"
      },
      "delete": {
        "summary": "Delete health log"
      },
      "get": {
        "summary": "Get health entry"
      }
    },
    "/api/v1/athletic": {
      "get": {
        "summary": "List athletic logs"
      },
      "post": {
        "summary": "Create athletic log"
      }
    },
    "/api/v1/athletic/{id}": {
      "patch": {
        "summary": "Update athletic log"
      },
      "delete": {
        "summary": "Delete athletic log"
      },
      "get": {
        "summary": "Get athletic entry"
      }
    },
    "/api/v1/money": {
      "get": {
        "summary": "List money entries"
